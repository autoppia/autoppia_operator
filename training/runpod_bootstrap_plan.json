  "training_command": "python -m training.finetune_bu --base-model browser-use/bu-30b-a3b-preview --data data/autocinema_trajectory_harvest/sft/train.jsonl --val-data data/autocinema_trajectory_harvest/sft/val.jsonl --output-dir models/bu-30b-lora --epochs 3 --lr 2e-4 --lora-rank 32 --lora-alpha 64 --batch-size 2 --grad-accum 8",
